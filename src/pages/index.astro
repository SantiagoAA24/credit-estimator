---
import Base from "../layouts/Base.astro";
import Simulador from "../components/Simulador.tsx";

const preguntas = [
  {
    p: "¿Qué es mejor: abonar para reducir plazo o para reducir cuota?",
    r: "Reducir plazo casi siempre ahorra más intereses, porque sigues pagando la misma cuota y el capital baja más rápido. Reducir cuota te deja más dinero libre cada mes. El simulador te muestra los dos escenarios lado a lado para que decidas con números.",
  },
  {
    p: "¿Cuál es la diferencia entre tasa E.A. y N.M.V.?",
    r: "La tasa efectiva anual (E.A.) incluye el efecto de capitalizar intereses cada mes. La nominal mes vencido (N.M.V.) es simplemente la tasa mensual multiplicada por 12. Un 12 % N.M.V. equivale a cerca de 12,68 % E.A. Puedes ingresar la tasa en cualquiera de los dos formatos.",
  },
  {
    p: "¿Cómo se calcula la cuota?",
    r: "Con el sistema francés de cuota fija: C = P · i(1+i)ⁿ / ((1+i)ⁿ − 1), donde P es el monto, i la tasa mensual y n el número de cuotas. Al principio la mayor parte de la cuota son intereses y, con el tiempo, cada vez más va a capital.",
  },
  {
    p: "¿Puedo abonar con las primas o las cesantías?",
    r: "Sí. Usa los botones «Primas (jun y dic)» o «Cesantías (feb)» y el simulador ubicará los abonos en los meses correctos según la fecha de tu primera cuota. Consulta con tu banco o fondo cómo aplicar el retiro de cesantías a tu crédito.",
  },
  {
    p: "¿Este simulador incluye créditos en UVR?",
    r: "Todavía no. Por ahora simula créditos en pesos con cuota fija. Los créditos en UVR se ajustan con la inflación y su cuota en pesos cambia cada mes.",
  },
];
---

<Base
  title="Simulador de crédito hipotecario con abonos a capital"
  description="Calcula tu cuota de crédito de vivienda y descubre cuánto ahorras en intereses y tiempo abonando a capital: abonos únicos, mensuales, con primas o cesantías. Compara reducir plazo vs. reducir cuota."
>
  <header class="border-b border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:py-10">
      <p class="text-sm font-medium text-marca-600">Simulador de crédito hipotecario · Colombia</p>
      <h1 class="mt-2 max-w-3xl text-3xl font-bold tracking-tight sm:text-4xl">
        ¿Cuánto te ahorras si abonas a tu crédito de vivienda?
      </h1>
      <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-400">
        Ajusta tu crédito, programa abonos a capital —únicos, mensuales, con primas o cesantías— y mira cómo cambian
        los intereses, la cuota y la fecha en que terminas de pagar.
      </p>
    </div>
  </header>

  <main class="mx-auto max-w-7xl px-4 py-6 sm:py-8">
    <Simulador client:only="react">
      <p slot="fallback" class="py-20 text-center text-slate-500">Cargando simulador…</p>
    </Simulador>

    <section class="mx-auto mt-16 max-w-3xl">
      <h2 class="text-2xl font-bold">Preguntas frecuentes</h2>
      <div class="mt-4 divide-y divide-slate-200 dark:divide-slate-800">
        {
          preguntas.map(({ p, r }) => (
            <details class="group py-4">
              <summary class="cursor-pointer list-none font-medium">
                {p}
              </summary>
              <p class="mt-2 text-slate-600 dark:text-slate-400">{r}</p>
            </details>
          ))
        }
      </div>
    </section>
  </main>

  <footer class="mt-12 border-t border-slate-200 dark:border-slate-800">
    <div class="mx-auto max-w-7xl px-4 py-6 text-xs text-slate-500 dark:text-slate-400">
      Esta herramienta es una simulación con fines educativos y no constituye asesoría financiera. Los valores reales
      dependen de las condiciones de tu entidad financiera (tasa, seguros, comisiones y forma de aplicar los abonos).
      Todos los cálculos se hacen en tu navegador; no guardamos tus datos.
    </div>
  </footer>
</Base>
